# Copy to .env for local development. The server reads only environment
# variables; `npm start` and `npm run dev:server` load this file if present.

# PostgreSQL 14 or newer. Matches docker-compose.yml's db service.
DATABASE_URL=postgresql://decent_sync:decent_sync@localhost:5432/decent_sync

# Optional: the PostgreSQL server tests create their databases on, used before
# DATABASE_URL. `npm run db:test` starts it, in Docker, and prints this URL.
# When Docker runs in a VM, an address that reaches the container directly,
# such as the VM's own, is much faster than localhost through a port
# forwarder: about 71 µs against about 170 µs per round trip. On the same
# machine, a full `npm test` at 5 workers took 178 s over the direct address
# against 212 s through the forwarder.
# TEST_DATABASE_URL=postgresql://decent_sync:decent_sync@localhost:55432/decent_sync

# The http:// or https:// address people and plugins use to reach the server.
PUBLIC_URL=http://localhost:3000

# Optional: the port and address to listen on (defaults 3000 and 0.0.0.0).
# PORT=3000
# HOST=0.0.0.0

# Optional: seconds a plugin has to send hello after connecting (default 10),
# and between its heartbeats (default 30).
# SYNC_HELLO_TIMEOUT_SECONDS=10
# SYNC_HEARTBEAT_SECONDS=30

# Seconds a stopping server still answers requests, so a proxy routing by its
# health check notices (default 15). With no proxy, as here, stop at once.
DRAIN_GRACE_SECONDS=0

# Optional: behind a reverse proxy, the request header holding the client's
# address, such as X-Forwarded-For or X-Real-IP. Set it only when every
# request comes through a proxy that sets or overwrites it.
# CLIENT_ADDRESS_HEADER=X-Forwarded-For
