// Decent Sync's database. PostgreSQL 14 or newer is required for lz4 column
// compression; the first migration refuses older servers.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Tables and columns use PostgreSQL's snake_case; models keep Prisma's casing.
//
// Times the server stores come from PostgreSQL's clock, never an instance's
// (ADR-0016). Prisma fills @default(now()) itself, with the instance's clock,
// so creation times default to dbgenerated("transaction_timestamp()"), which
// is now() under a name Prisma leaves to the database: it reads now() and
// CURRENT_TIMESTAMP back as its own now(). @updatedAt is still the instance's.

enum AccountRole {
  ADMIN
  STAFF

  @@map("account_role")
}

/// A person who signs in to the management interface. Baristas named on
/// tablets need no account.
model Account {
  id            String      @id @default(uuid(7)) @db.Uuid
  /// Stored trimmed and lower-cased, so sign-in ignores case.
  email         String      @unique
  name          String
  role          AccountRole
  /// scrypt, in the self-describing format of server/src/accounts/passwords.ts.
  passwordHash  String      @map("password_hash")
  createdAt     DateTime    @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Set by PostgreSQL's clock when an Admin deactivates the account, which
  /// ends its sessions and refuses its sign-ins; null while it is active.
  deactivatedAt DateTime?   @map("deactivated_at") @db.Timestamptz(3)

  sessions      Session[]
  /// The Locations a Staff member works at. An Admin sees every Location and has none.
  locations     StaffLocation[]
  /// The password reset link issued for it, if any.
  passwordReset PasswordReset?
  itemVersions  ItemVersion[]
  conflicts     Conflict[]

  @@map("accounts")
}

/// A Location a Staff member works at. Staff move Machines only between these
/// Locations; they read everything else as Admins do, but other accounts'
/// personal information. Read on every request, so a change applies to the next.
model StaffLocation {
  accountId  String   @map("account_id") @db.Uuid
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  locationId String   @map("location_id") @db.Uuid
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([accountId, locationId])
  @@index([locationId])
  @@map("staff_locations")
}

/// A one-time link an Admin creates and sends someone themselves, which
/// creates their account. The link holds a random secret; only its SHA-256
/// hash is stored, as for sessions. See server/src/accounts/invites.service.ts.
model Invite {
  id         String      @id @default(uuid(7)) @db.Uuid
  secretHash Bytes       @unique @map("secret_hash")
  /// The email the account will sign in with, stored trimmed and lower-cased.
  email      String
  role       AccountRole
  createdAt  DateTime    @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(3)
  /// Set and judged by PostgreSQL's clock, whichever instance creates or accepts it.
  expiresAt  DateTime    @map("expires_at") @db.Timestamptz(3)
  /// Set once, by a conditional update, so it is used once whichever instance accepts it.
  acceptedAt DateTime?   @map("accepted_at") @db.Timestamptz(3)
  /// Set when an Admin revokes it unused, by the same kind of conditional
  /// update, so an invite is either accepted or revoked, never both.
  revokedAt  DateTime?   @map("revoked_at") @db.Timestamptz(3)

  locations InviteLocation[]

  @@map("invites")
}

/// A Location a Staff invite's account will work at.
model InviteLocation {
  inviteId   String   @map("invite_id") @db.Uuid
  invite     Invite   @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  locationId String   @map("location_id") @db.Uuid
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([inviteId, locationId])
  @@index([locationId])
  @@map("invite_locations")
}

/// A one-time link an Admin issues and sends someone themselves, with which
/// they choose a new password. An account has at most one: issuing another
/// replaces it. The link holds a random secret; only its SHA-256 hash is
/// stored. See server/src/accounts/password-resets.service.ts.
model PasswordReset {
  id         String    @id @default(uuid(7)) @db.Uuid
  secretHash Bytes     @unique @map("secret_hash")
  accountId  String    @unique @map("account_id") @db.Uuid
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @map("created_at") @db.Timestamptz(3)
  /// Set and judged by PostgreSQL's clock, whichever instance issues or redeems it.
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set once, by a conditional update, so it is used once whichever instance redeems it.
  usedAt     DateTime? @map("used_at") @db.Timestamptz(3)

  @@map("password_resets")
}

/// A signed-in browser. The cookie holds a random token; only its SHA-256
/// hash is stored, so a database leak cannot be replayed as a session.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  tokenHash Bytes    @unique @map("token_hash")
  accountId String   @map("account_id") @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(3)
  /// Pushed forward as the session is used, so a device in use stays signed in.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([accountId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Recent sign-in attempts for one email, shared by every server instance.
/// See server/src/accounts/sign-in-limiter.ts.
model SignInWindow {
  /// As entered at sign-in, whether or not an account has it.
  email     String   @id
  attempts  Int
  /// By PostgreSQL's clock, which every instance judges it by.
  startedAt DateTime @default(dbgenerated("transaction_timestamp()")) @map("started_at") @db.Timestamptz(3)

  @@index([startedAt])
  @@map("sign_in_windows")
}

/// A physical site where machines are used, such as a roastery lab or a cafe.
model Location {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Stored trimmed; unique so choosers can name a Location unambiguously.
  name      String   @unique
  /// An IANA time zone, spelled as PostgreSQL knows it, so date filters can
  /// use it with AT TIME ZONE. See server/src/locations/time-zones.ts.
  timeZone  String   @map("time_zone")
  createdAt DateTime @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignments     LocationAssignment[]
  shots           Shot[]
  steamRecords    SteamRecord[]
  staff           StaffLocation[]
  invites         InviteLocation[]
  beansCreated    Bean[]               @relation("BeansCreated")
  beanOrigins     BeanOrigin[]
  batchesCreated  BeanBatch[]          @relation("BeanBatchesCreated")
  batches         BatchLocation[]
  profilesCreated Profile[]            @relation("ProfilesCreated")
  profiles        ProfileLocation[]
  grinders        Grinder[]
  settings        LocationSettings?
  itemVersions    ItemVersion[]
  conflicts       Conflict[]

  @@map("locations")
}

/// How a Machine's identity stood at the last accepted `hello` from its
/// token (ADR-0004, ADR-0015), or since an Admin entered its hardware.
enum MachineIdentification {
  /// Its token has not reported hardware yet: it never connected, or its
  /// tablet's machine was off and its connection id is not a known alias.
  HARDWARE_NOT_REPORTED
  IDENTIFIED
  /// Its machine reports no real serial ("0" or none).
  UNIDENTIFIED
  /// Its token reported real hardware other than the hardware it is bound to.
  MISMATCH

  @@map("machine_identification")
}

/// A piece of Decent espresso hardware, adopted by an Admin creating its
/// machine entry. Its identity is its model and serial (ADR-0004), bound when
/// a connection with its token first reports real ones, or entered by an Admin.
model Machine {
  id                 String                @id @default(uuid(7)) @db.Uuid
  /// Stored trimmed; unique so lists and choosers name a Machine unambiguously.
  name               String                @unique
  /// The hardware its token is bound to; null until bound.
  model              String?
  serial             String?
  identification     MachineIdentification @default(HARDWARE_NOT_REPORTED)
  /// The hardware the latest `hello` that reported any did, as reported:
  /// for a mismatch, the other hardware; for an Unidentified Machine, its "0".
  reportedModel      String?               @map("reported_model")
  reportedSerial     String?               @map("reported_serial")
  firmware           String?
  /// The connection id, plugin and Decaid versions of the latest accepted
  /// `hello`, and the address its connection came from as the server saw it.
  connectionId       String?               @map("connection_id")
  pluginVersion      String?               @map("plugin_version")
  decaidVersion      String?               @map("decaid_version")
  remoteAddress      String?               @map("remote_address")
  /// Whether its tablet shares its Location's steam, hot water and rinse
  /// settings (ADR-0014): with sharing turned off, nothing of them is taken
  /// from it or written to it, and with sharing turned back on it takes the
  /// Location's.
  sharesSettings     Boolean               @default(true) @map("shares_settings")
  /// When an account last switched it on, by PostgreSQL's clock; null if
  /// never. A change its tablet observed before then, delivered after, was
  /// made while it kept its own settings, and is not shared.
  sharesSettingsSince DateTime?            @map("shares_settings_since") @db.Timestamptz(3)
  /// Why a connection with its token was last refused, until one is accepted.
  refusalReason      String?               @map("refusal_reason")
  refusedAt          DateTime?             @map("refused_at") @db.Timestamptz(3)
  /// When a plugin connected with its token was last heard from.
  lastSeenAt         DateTime?             @map("last_seen_at") @db.Timestamptz(3)
  /// The connection that holds the Machine, on whichever server instance:
  /// written when a hello is accepted, cleared when that connection closes.
  /// Online while set and heard from recently, so a crashed instance's
  /// connections go offline by themselves.
  connectedSessionId String?               @map("connected_session_id") @db.Uuid
  /// The tablet that connection comes from, set and cleared with it, so the
  /// next accepted `hello` can tell another tablet from this one reconnecting.
  connectedTabletId  String?               @map("connected_tablet_id") @db.Uuid
  createdAt          DateTime              @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  shots              Shot[]
  steamRecords       SteamRecord[]
  tokens             MachineToken[]
  aliases            MachineAlias[]
  dismissedHardware  DismissedHardware[]
  locationHistory    LocationAssignment[]
  workflowEvents     WorkflowEvent[]
  machineStateEvents MachineStateEvent[]
  eventDeliveries    MachineEventDelivery[]
  collections        ReportedCollection[]
  tablets            MachineTablet[]
  setAsideDeliveries SetAsideDelivery[]
  itemVersions       ItemVersion[]
  conflicts          Conflict[]
  takeover           Takeover?

  /// One Machine per piece of hardware. Unbound Machines (nulls) never clash.
  @@unique([model, serial])
  @@map("machines")
}

/// One entry of a Machine's Location History: it was at the Location from
/// `effectiveFrom` until its next entry's. Before its first entry, or with
/// none, its Location is unknown. See server/src/machines/location-history.ts.
model LocationAssignment {
  id            String   @id @default(uuid(7)) @db.Uuid
  machineId     String   @map("machine_id") @db.Uuid
  machine       Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  locationId    String   @map("location_id") @db.Uuid
  location      Location @relation(fields: [locationId], references: [id])
  /// By PostgreSQL's clock when it is now, or as an Admin entered it.
  effectiveFrom DateTime @map("effective_from") @db.Timestamptz(3)
  createdAt     DateTime @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(3)

  @@unique([machineId, effectiveFrom])
  @@map("location_assignments")
}

/// The secret a Machine's plugin connects with. It is shown once, when it is
/// issued; only its SHA-256 hash is stored.
model MachineToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  tokenHash Bytes     @unique @map("token_hash")
  machineId String    @map("machine_id") @db.Uuid
  machine   Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(3)
  /// Set when a newer token replaces it; a revoked token connects nothing.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([machineId])
  @@map("machine_tokens")
}

/// A connection id (Decaid's preferredMachineId: a Bluetooth address or a USB
/// id) shown to belong to a Machine. It recognises the Machine when its
/// hardware cannot, but is not its identity. USB ids can repeat across
/// tablets, so the same id may be an alias of several Machines.
model MachineAlias {
  machineId    String   @map("machine_id") @db.Uuid
  machine      Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  connectionId String   @map("connection_id")
  createdAt    DateTime @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(3)

  @@id([machineId, connectionId])
  @@map("machine_aliases")
}

/// Hardware the server has seen that no Machine has: reported by a tablet
/// connected with another Machine's token (a mismatch), or, from ticket #9,
/// named by a Shot. An Admin creates a machine entry for it, which takes over
/// what was held for it, or dismisses it.
model PendingMachine {
  shots        Shot[]
  steamRecords SteamRecord[]
  id           String        @id @default(uuid(7)) @db.Uuid
  model        String
  serial       String
  createdAt    DateTime      @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(3)
  /// When a connection last reported it.
  lastSeenAt   DateTime?     @map("last_seen_at") @db.Timestamptz(3)
  /// Dismissed Pending Machines stay, so creating a machine entry later restores what they hold.
  dismissedAt  DateTime?     @map("dismissed_at") @db.Timestamptz(3)

  workflowEvents     WorkflowEvent[]
  machineStateEvents MachineStateEvent[]
  collections        ReportedCollection[]
  tablets            MachineTablet[]

  @@unique([model, serial])
  @@map("pending_machines")
}

/// A tablet: the device running Decaid together with its Decaid data, known
/// by the id its plugin made on its first run and keeps in Decaid's plugin
/// storage (ADR-0006). Resetting that data makes a new tablet; restoring a
/// Decaid backup brings the old one back. A tablet may move between Machines.
model Tablet {
  /// The id the plugin made: a random UUID, sent in every `hello`.
  id          String   @id @db.Uuid
  /// When a `hello` with it was first accepted, by PostgreSQL's clock.
  firstSeenAt DateTime @map("first_seen_at") @db.Timestamptz(3)

  machines     MachineTablet[]
  beans        TabletBean[]
  beanBatches  TabletBeanBatch[]
  grinders     TabletGrinder[]
  profiles     TabletProfile[]
  settings     TabletSettings?
  itemVersions ItemVersion[]
  conflicts    Conflict[]
  deletions    TabletDeletion[]

  @@map("tablets")
}

/// A tablet that connections were accepted from, recorded against whoever
/// those connections resolved to, as their records are: the token's Machine,
/// or, for a mismatch, the reported hardware's Machine, or the Pending
/// Machine holding it until a Machine takes it over. One tablet on several
/// Machines has a row for each. Times are PostgreSQL's clock: first seen at
/// the first accepted `hello`, and last seen at the latest `hello` or
/// heartbeat.
model MachineTablet {
  id               BigInt          @id @default(autoincrement())
  tabletId         String          @map("tablet_id") @db.Uuid
  tablet           Tablet          @relation(fields: [tabletId], references: [id], onDelete: Cascade)
  machineId        String?         @map("machine_id") @db.Uuid
  machine          Machine?        @relation(fields: [machineId], references: [id], onDelete: Cascade)
  pendingMachineId String?         @map("pending_machine_id") @db.Uuid
  pendingMachine   PendingMachine? @relation(fields: [pendingMachineId], references: [id], onDelete: Cascade)
  firstSeenAt      DateTime        @map("first_seen_at") @db.Timestamptz(3)
  /// Numbers its latest accepted `hello`, from a sequence every instance
  /// shares, under a lock every hello takes last and holds until it commits,
  /// so numbers rise in the order hellos are accepted: the highest of a
  /// Machine's records is its latest connection's tablet.
  lastHello        BigInt          @default(autoincrement()) @map("last_hello")
  lastSeenAt       DateTime        @map("last_seen_at") @db.Timestamptz(3)

  @@unique([tabletId, machineId])
  @@unique([tabletId, pendingMachineId])
  @@index([machineId])
  @@index([pendingMachineId])
  @@map("machine_tablets")
}

/// The latest takeover of a Machine: a `hello` with its token, from one
/// tablet, accepted while a live connection from another tablet held it,
/// which it replaced. Recorded in the transaction that accepts the `hello`,
/// under the Machine's row lock, and replaced by the next takeover. See
/// server/src/machines/takeovers.ts.
model Takeover {
  machineId             String   @id @map("machine_id") @db.Uuid
  machine               Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  /// When the `hello` that took over was accepted, by PostgreSQL's clock.
  at                    DateTime @db.Timestamptz(3)
  /// The connection replaced: its tablet, the address it came from, and the
  /// connection id, plugin and Decaid versions of its `hello`.
  replacedTabletId      String   @map("replaced_tablet_id") @db.Uuid
  replacedRemoteAddress String   @map("replaced_remote_address")
  replacedConnectionId  String?  @map("replaced_connection_id")
  replacedPluginVersion String   @map("replaced_plugin_version")
  replacedDecaidVersion String   @map("replaced_decaid_version")
  /// The connection that took over, the same way.
  tabletId              String   @map("tablet_id") @db.Uuid
  remoteAddress         String   @map("remote_address")
  connectionId          String?  @map("connection_id")
  pluginVersion         String   @map("plugin_version")
  decaidVersion         String   @map("decaid_version")

  @@map("takeovers")
}

/// Hardware an Admin dismissed for one reporting Machine. Connections using
/// that Machine's tokens are refused for this hardware, including after token rotation.
model DismissedHardware {
  machineId String   @map("machine_id") @db.Uuid
  machine   Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  model     String
  serial    String
  createdAt DateTime @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(3)

  @@id([machineId, model, serial])
  @@map("dismissed_hardware")
}

/// A Decaid Shot, unique across reporting tablets. An edit may arrive before
/// its full record: it is durable here, but hidden until the full record arrives.
model Shot {
  id               String            @id
  hasFullRecord    Boolean           @default(false) @map("has_full_record")
  record           Json              @db.JsonB
  versionAt        DateTime          @map("version_at") @db.Timestamptz(6)
  machineId        String?           @map("machine_id") @db.Uuid
  machine          Machine?          @relation(fields: [machineId], references: [id])
  pendingMachineId String?           @map("pending_machine_id") @db.Uuid
  pendingMachine   PendingMachine?   @relation(fields: [pendingMachineId], references: [id])
  machineInferred  Boolean           @default(false) @map("machine_inferred")
  /// Where its Machine was when it was pulled, by the Machine's Location
  /// History; null when unknown. Re-derived whenever that history changes.
  locationId       String?           @map("location_id") @db.Uuid
  location         Location?         @relation(fields: [locationId], references: [id])
  pulledAt         DateTime?         @map("pulled_at") @db.Timestamptz(3)
  /// The batch and Grinder its Workflow names, by their ids on the tablet
  /// that pulled it: an item whose record has such an id on any tablet is
  /// named by the Shot, and is never hard-deleted.
  beanBatchId      String?           @map("bean_batch_id")
  grinderId        String?           @map("grinder_id")
  coffeeName       String?           @map("coffee_name")
  coffeeRoaster    String?           @map("coffee_roaster")
  profileTitle     String?           @map("profile_title")
  profileId        String?           @map("profile_id")
  targetDose       Float?            @map("target_dose")
  actualDose       Float?            @map("actual_dose")
  targetYield      Float?            @map("target_yield")
  actualYield      Float?            @map("actual_yield")
  duration         Float?
  enjoyment        Float?
  barista          String?
  peakPressure     Float?            @map("peak_pressure")
  peakFlow         Float?            @map("peak_flow")
  measurements     ShotMeasurements?

  /// The migration orders both pulled_at columns NULLS LAST, as the queries do; Prisma cannot express that.
  @@index([pulledAt(sort: Desc), id])
  @@index([machineId, pulledAt(sort: Desc), id])
  @@index([pendingMachineId])
  @@index([beanBatchId])
  @@index([grinderId])
  @@map("shots")
}

model ShotMeasurements {
  shotId String @id @map("shot_id")
  shot   Shot   @relation(fields: [shotId], references: [id], onDelete: Cascade)
  /// lz4 column compression is set by the migration.
  data   Json   @db.JsonB

  @@map("shot_measurements")
}

/// A Decaid Steam Record, stored once by its id, whichever tablet reported it.
/// Decaid records no hardware on Steam Records, so it is credited to the
/// Machine whose tablet reported it, or, from a mismatched connection, to the
/// hardware that connection reported: the Machine that has it, otherwise its
/// Pending Machine (ADR-0015). Decaid offers no way to detect edits to Steam
/// Records, so a stored one never changes; only its credit moves, when a
/// machine entry takes over its Pending Machine's hardware or its Machine's
/// Location History changes.
model SteamRecord {
  id                   String             @id
  /// The record as Decaid sent it, without its measurements.
  record               Json               @db.JsonB
  machineId            String?            @map("machine_id") @db.Uuid
  machine              Machine?           @relation(fields: [machineId], references: [id])
  pendingMachineId     String?            @map("pending_machine_id") @db.Uuid
  pendingMachine       PendingMachine?    @relation(fields: [pendingMachineId], references: [id])
  /// Where its Machine was when it was recorded, by the Machine's Location
  /// History; null when unknown. Re-derived whenever that history changes.
  locationId           String?            @map("location_id") @db.Uuid
  location             Location?          @relation(fields: [locationId], references: [id])
  /// When it was recorded, as the plugin placed the record's local time in UTC.
  steamedAt            DateTime           @map("steamed_at") @db.Timestamptz(3)
  duration             Float?
  peakMilkTemperature  Float?             @map("peak_milk_temperature")
  finalMilkTemperature Float?             @map("final_milk_temperature")
  barista              String?
  measurements         SteamMeasurements?

  @@index([steamedAt(sort: Desc), id])
  @@index([machineId, steamedAt(sort: Desc), id])
  @@index([pendingMachineId])
  @@map("steam_records")
}

model SteamMeasurements {
  steamRecordId String      @id @map("steam_record_id")
  steamRecord   SteamRecord @relation(fields: [steamRecordId], references: [id], onDelete: Cascade)
  /// lz4 column compression is set by the migration.
  data          Json        @db.JsonB

  @@map("steam_measurements")
}

/// A Workflow a tablet reported: what its Machine was set up to do next, from
/// when the plugin observed it. Stored only when it differs from the latest
/// one stored for the same Machine or Pending Machine, so the latest is the
/// current Workflow. A mismatched connection's belong to its reported
/// hardware, as its inferred Shots do. See
/// server/src/machine-events/machine-events.service.ts.
model WorkflowEvent {
  /// Rises as events are stored; the highest is the latest.
  id               BigInt          @id @default(autoincrement())
  machineId        String?         @map("machine_id") @db.Uuid
  machine          Machine?        @relation(fields: [machineId], references: [id])
  pendingMachineId String?         @map("pending_machine_id") @db.Uuid
  pendingMachine   PendingMachine? @relation(fields: [pendingMachineId], references: [id])
  /// By the tablet's clock; the plugin may deliver it much later.
  observedAt       DateTime        @map("observed_at") @db.Timestamptz(3)
  /// By PostgreSQL's clock.
  receivedAt       DateTime        @default(dbgenerated("transaction_timestamp()")) @map("received_at") @db.Timestamptz(3)
  /// Decaid's Workflow, as sent.
  workflow         Json            @db.JsonB

  @@index([machineId, id])
  @@index([pendingMachineId, id])
  @@map("workflow_events")
}

/// A machine state transition: a change of the state or substate Decaid
/// reported, from when the plugin observed it. Stored and credited as
/// Workflow events are.
model MachineStateEvent {
  /// Rises as events are stored; the highest is the latest.
  id               BigInt          @id @default(autoincrement())
  machineId        String?         @map("machine_id") @db.Uuid
  machine          Machine?        @relation(fields: [machineId], references: [id])
  pendingMachineId String?         @map("pending_machine_id") @db.Uuid
  pendingMachine   PendingMachine? @relation(fields: [pendingMachineId], references: [id])
  observedAt       DateTime        @map("observed_at") @db.Timestamptz(3)
  receivedAt       DateTime        @default(dbgenerated("transaction_timestamp()")) @map("received_at") @db.Timestamptz(3)
  /// Decaid's names, such as espresso and preinfusion.
  state            String
  substate         String

  @@index([machineId, id])
  @@index([pendingMachineId, id])
  @@map("machine_state_events")
}

/// A Workflow, machine state or collection delivery the server has handled,
/// recorded whether or not it changed anything. The plugin keeps a delivery's id when
/// it sends it again, so a delivery recorded here changes nothing when it
/// arrives again, through any connection or instance. Kept for 90 days
/// (DELIVERY_ID_RETENTION_DAYS in server/src/machines/delivery-id-cleanup.ts):
/// only the plugin load that sent a delivery resends it, and a resend after
/// that changes at most one event or collection value.
model MachineEventDelivery {
  /// The Machine whose token delivered it: its plugin's delivery ids are its own.
  machineId  String   @map("machine_id") @db.Uuid
  machine    Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  deliveryId String   @map("delivery_id")
  /// By PostgreSQL's clock. The retention period counts from here.
  receivedAt DateTime @default(dbgenerated("transaction_timestamp()")) @map("received_at") @db.Timestamptz(3)

  @@id([machineId, deliveryId])
  /// Finds the ids old enough to delete without reading the whole table.
  @@index([receivedAt])
  @@map("machine_event_deliveries")
}

/// The latest value of one of the collections a tablet reports (its library,
/// settings and paired devices; COLLECTION_NAMES in protocol/), for a Machine,
/// or held by a Pending Machine for hardware a mismatched connection reported
/// until a Machine takes it over. Only the latest is kept. See
/// server/src/collections/collections.service.ts.
model ReportedCollection {
  id               BigInt          @id @default(autoincrement())
  machineId        String?         @map("machine_id") @db.Uuid
  machine          Machine?        @relation(fields: [machineId], references: [id], onDelete: Cascade)
  pendingMachineId String?         @map("pending_machine_id") @db.Uuid
  pendingMachine   PendingMachine? @relation(fields: [pendingMachineId], references: [id], onDelete: Cascade)
  /// One of the protocol's COLLECTION_NAMES.
  name             String
  /// Whether the latest report had a value: false while, say, no scale is connected.
  available        Boolean
  /// When the latest report, available or not, was received, by PostgreSQL's clock.
  reportedAt       DateTime        @map("reported_at") @db.Timestamptz(3)
  /// The latest value reported, as Decaid sent it; null until one is. An
  /// unavailable report keeps it. lz4 column compression is set by the migration.
  value            Json?           @db.JsonB
  /// When that value was received, by PostgreSQL's clock.
  receivedAt       DateTime?       @map("received_at") @db.Timestamptz(3)
  /// How many entries the value lists, if it is a list, so summaries need not read it.
  items            Int?

  @@unique([machineId, name])
  @@unique([pendingMachineId, name])
  @@map("reported_collections")
}

/// A delivery whose storage failed in a way that would repeat whenever it was
/// sent again, such as a NUL in a string, which jsonb and text cannot hold
/// (server/src/set-aside-deliveries/repeating-failures.ts). It is kept here as
/// received and acknowledged as if stored, so it cannot hold up the deliveries
/// queued behind it on the tablet. Recorded once per delivery id, through any
/// connection or instance. A Shot or Steam Record set aside is not requested
/// again by indexes from the same Machine.
model SetAsideDelivery {
  /// Rises as deliveries are set aside; the highest is the latest.
  id         BigInt   @id @default(autoincrement())
  /// The Machine whose token delivered it: its plugin's delivery ids are its own.
  machineId  String   @map("machine_id") @db.Uuid
  machine    Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  deliveryId String   @map("delivery_id")
  /// The message's type, such as shot or collection.
  type       String
  /// The Decaid id of a Shot's or Steam Record's; null for other deliveries.
  recordId   String?  @map("record_id")
  /// PostgreSQL's error code for the failure, such as 22P05, and its message.
  sqlState   String   @map("sql_state")
  error      String
  /// By PostgreSQL's clock.
  receivedAt DateTime @default(dbgenerated("transaction_timestamp()")) @map("received_at") @db.Timestamptz(3)
  /// The message as received: its JSON text, with escapes such as \u0000 as
  /// sent. lz4 column compression is set by the migration.
  message    String

  @@unique([machineId, deliveryId])
  @@index([machineId, id])
  /// Finds the Shots and Steam Records set aside, which indexes leave out.
  @@index([machineId, recordId])
  @@map("set_aside_deliveries")
}

/// A Bean in the Library (ADR-0003): a coffee as sold by a roaster, shared
/// with the tablets of each Location that offers it (ADR-0008). Its id is its
/// global id, which the plugin writes into its record on each tablet
/// (ADR-0006). See server/src/library/beans.ts.
model Bean {
  id                String    @id @default(uuid(7)) @db.Uuid
  /// Decaid's record fields, those it does not know included, as the tablet
  /// that created it sent them: all but its id, times, archived flag and
  /// extras, which belong to each tablet's record.
  content           Json      @db.JsonB
  /// Its roaster and name as Beans are matched (ADR-0018), without spaces at
  /// either end and in lower case (server/src/library/bean-matching.ts).
  matchKey          String    @map("match_key")
  /// Retired everywhere: offered nowhere, but kept so past Shots still name it.
  archived          Boolean   @default(false)
  /// The Location of the tablet that created it.
  createdLocationId String?   @map("created_location_id") @db.Uuid
  createdLocation   Location? @relation("BeansCreated", fields: [createdLocationId], references: [id], onDelete: SetNull)
  /// When it joined the Library, by PostgreSQL's clock.
  createdAt         DateTime  @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(3)
  /// Each content field's latest edit (ADR-0020), by the field's name:
  /// `{ at, decidedAt, tabletId, versionId }`, the edit's time, when it was
  /// decided by PostgreSQL's clock, the tablet that made it, if one did, and
  /// its version (server/src/library/content-edits.ts).
  fieldEdits        Json      @default("{}") @map("field_edits") @db.JsonB

  origins   BeanOrigin[]
  tablets   TabletBean[]
  batches   BeanBatch[]
  versions  ItemVersion[]
  conflicts Conflict[]

  @@index([matchKey])
  @@map("beans")
}

/// A Location offering a Bean that has no batch there yet (ADR-0008): one
/// where a tablet created the Bean, linked a bean of its own to it by roaster
/// and name (ADR-0018), or un-archived its record, while none of its batches
/// was there. A batch of it added there ends it, as does archiving or
/// deleting the Bean on a tablet there (ADR-0019); from then on the Bean is
/// offered there only while one of its batches is.
model BeanOrigin {
  beanId     String   @map("bean_id") @db.Uuid
  bean       Bean     @relation(fields: [beanId], references: [id], onDelete: Cascade)
  locationId String   @map("location_id") @db.Uuid
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  /// When it was created, linked or un-archived there, by PostgreSQL's clock.
  since      DateTime @default(dbgenerated("transaction_timestamp()")) @db.Timestamptz(3)

  @@id([beanId, locationId])
  @@index([locationId])
  @@map("bean_origins")
}

/// A Library Bean's record on one tablet (ADR-0006): its id there, and the
/// record as that tablet last had it, as it reported it or as Decaid returned
/// the plugin's write. Kept per tablet, so a reset tablet, which has a new
/// tablet id, holds nothing here.
model TabletBean {
  tabletId        String    @map("tablet_id") @db.Uuid
  tablet          Tablet    @relation(fields: [tabletId], references: [id], onDelete: Cascade)
  beanId          String    @map("bean_id") @db.Uuid
  bean            Bean      @relation(fields: [beanId], references: [id], onDelete: Cascade)
  /// Decaid's id for the record on that tablet.
  localId         String    @map("local_id")
  /// The record, as Decaid sent it.
  record          Json      @db.JsonB
  /// The record's updatedAt, placed in UTC by the plugin; null if it could not be.
  recordUpdatedAt DateTime? @map("record_updated_at") @db.Timestamptz(3)
  /// The latest decision of whether any of the Bean's batches is at the
  /// Location that the record has seen (`BatchLocation.presenceDecidedAt`):
  /// one the server's write to it carried; null if none. Its own archiving
  /// does not count, as it may leave batches added since in place.
  /// Archiving or deleting the Bean is judged by it (ADR-0020).
  seenAt          DateTime? @map("seen_at") @db.Timestamptz(3)
  /// The Location of that decision: it says nothing of another's. No foreign
  /// key: it is only compared with the tablet's Location now.
  seenLocationId  String?   @map("seen_location_id") @db.Uuid

  /// The latest edit of the item's content that the record has seen
  /// (`fieldEdits` `decidedAt`): when the edits it held were decided, by
  /// PostgreSQL's clock, as the server's write it answered carried them;
  /// null if none. Its own edits it has seen whatever this says (ADR-0020).
  contentSeenAt DateTime? @map("content_seen_at") @db.Timestamptz(3)

  @@id([tabletId, beanId])
  @@unique([tabletId, localId])
  @@index([beanId])
  @@map("tablet_beans")
}

/// One roast of a Bean (ADR-0008), by its global id (ADR-0006). Its content
/// is the same everywhere; whether it is at each Location, and its remaining
/// weight there, are each Location's own (`BatchLocation`).
model BeanBatch {
  id                String    @id @default(uuid(7)) @db.Uuid
  beanId            String    @map("bean_id") @db.Uuid
  bean              Bean      @relation(fields: [beanId], references: [id], onDelete: Cascade)
  /// Decaid's record fields, those it does not know included, as the tablet
  /// that created it sent them: all but its id, its Bean's id on that tablet,
  /// its times, `archived`, `weightRemaining` and `extras`, which belong to
  /// each tablet's record or to each Location.
  content           Json      @db.JsonB
  /// Retired everywhere: offered nowhere, but kept so past Shots still name it.
  archived          Boolean   @default(false)
  /// The Location of the tablet that created it.
  createdLocationId String?   @map("created_location_id") @db.Uuid
  createdLocation   Location? @relation("BeanBatchesCreated", fields: [createdLocationId], references: [id], onDelete: SetNull)
  /// When it joined the Library, by PostgreSQL's clock.
  createdAt         DateTime  @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(3)
  /// Each content field's latest edit (ADR-0020), by the field's name:
  /// `{ at, decidedAt, tabletId, versionId }`, the edit's time, when it was
  /// decided by PostgreSQL's clock, the tablet that made it, if one did, and
  /// its version (server/src/library/content-edits.ts).
  fieldEdits        Json      @default("{}") @map("field_edits") @db.JsonB

  locations BatchLocation[]
  tablets   TabletBeanBatch[]
  versions  ItemVersion[]
  conflicts Conflict[]

  @@index([beanId])
  @@map("bean_batches")
}

/// A Bean Batch's state at one Location (ADR-0008), each part a field of its
/// own (ADR-0020): whether it is there, from when it was added until it is
/// finished, and its remaining weight there, the latest value entered. Each
/// part keeps the time of the edit that set it, a tablet's edits by the
/// record's `updatedAt` in UTC (ADR-0003).
model BatchLocation {
  batchId                  String    @map("batch_id") @db.Uuid
  batch                    BeanBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  locationId               String    @map("location_id") @db.Uuid
  location                 Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  /// When it was last added there; null if it never was, as for a batch whose
  /// remaining weight was entered there while it was elsewhere.
  addedAt                  DateTime? @map("added_at") @db.Timestamptz(3)
  /// When it was finished there after it was last added; null while it is there.
  finishedAt               DateTime? @map("finished_at") @db.Timestamptz(3)
  /// When it was last added or finished there, by PostgreSQL's clock: a
  /// tablet whose record of the batch, or for archiving or deleting its Bean
  /// of the Bean, has seen it had seen it (`TabletBeanBatch.seenAt`,
  /// `TabletBean.seenAt`).
  presenceDecidedAt        DateTime? @map("presence_decided_at") @db.Timestamptz(3)
  /// The remaining weight entered there last, in grams; null if it was cleared.
  remainingWeight          Float?    @map("remaining_weight")
  /// When that weight was entered; null if none ever was there.
  remainingWeightAt        DateTime? @map("remaining_weight_at") @db.Timestamptz(3)
  /// The version that last added or finished it there (`ItemVersion`), if
  /// one is known: who did, for a Conflict it may become. No foreign key:
  /// versions go only with their item, which takes this row with it.
  presenceVersionId        String?   @map("presence_version_id") @db.Uuid
  /// The version that entered the remaining weight there, as `presenceVersionId`.
  remainingWeightVersionId String?   @map("remaining_weight_version_id") @db.Uuid

  @@id([batchId, locationId])
  @@index([locationId])
  @@map("batch_locations")
}

/// A Library Bean Batch's record on one tablet (ADR-0006), as `TabletBean`
/// keeps a Bean's: its id there, and the record as that tablet last had it.
model TabletBeanBatch {
  tabletId        String    @map("tablet_id") @db.Uuid
  tablet          Tablet    @relation(fields: [tabletId], references: [id], onDelete: Cascade)
  batchId         String    @map("batch_id") @db.Uuid
  batch           BeanBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  /// Decaid's id for the record on that tablet.
  localId         String    @map("local_id")
  /// The record, as Decaid sent it.
  record          Json      @db.JsonB
  /// The record's updatedAt, placed in UTC by the plugin; null if it could not be.
  recordUpdatedAt DateTime? @map("record_updated_at") @db.Timestamptz(3)
  /// The latest decision of whether the batch is at the Location that the
  /// record has seen (`BatchLocation.presenceDecidedAt`): one the server's
  /// write to it carried, or one its own edit made; null if none (ADR-0020).
  seenAt          DateTime? @map("seen_at") @db.Timestamptz(3)
  /// The Location of that decision: it says nothing of another's. No foreign
  /// key: it is only compared with the tablet's Location now.
  seenLocationId  String?   @map("seen_location_id") @db.Uuid

  /// The latest edit of the item's content that the record has seen
  /// (`fieldEdits` `decidedAt`): when the edits it held were decided, by
  /// PostgreSQL's clock, as the server's write it answered carried them;
  /// null if none. Its own edits it has seen whatever this says (ADR-0020).
  contentSeenAt DateTime? @map("content_seen_at") @db.Timestamptz(3)

  @@id([tabletId, batchId])
  @@unique([tabletId, localId])
  @@index([batchId])
  @@map("tablet_bean_batches")
}

/// A Grinder in the Library (ADR-0003), by its global id (ADR-0006): equipment
/// that belongs to one Location, the one where it was created, and is offered
/// only there (ADR-0008). Archiving or deleting it on a tablet there Archives
/// it (ADR-0019). See server/src/library/grinders.ts.
model Grinder {
  id         String    @id @default(uuid(7)) @db.Uuid
  /// Decaid's record fields, those it does not know included, as the tablet
  /// that created it sent them: all but its id, times, archived flag and
  /// extras, which belong to each tablet's record.
  content    Json      @db.JsonB
  /// Retired everywhere: offered nowhere, but kept so past Shots still name it.
  archived   Boolean   @default(false)
  /// The Location it belongs to: that of the tablet that created it.
  locationId String?   @map("location_id") @db.Uuid
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  /// When it joined the Library, by PostgreSQL's clock.
  createdAt  DateTime  @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(3)
  /// Each content field's latest edit (ADR-0020), `archived` included, as
  /// `Bean.fieldEdits` keeps a Bean's.
  fieldEdits Json      @default("{}") @map("field_edits") @db.JsonB

  tablets   TabletGrinder[]
  versions  ItemVersion[]
  conflicts Conflict[]

  @@index([locationId])
  @@map("grinders")
}

/// A Library Grinder's record on one tablet (ADR-0006), as `TabletBean`
/// keeps a Bean's: its id there, and the record as that tablet last had it.
model TabletGrinder {
  tabletId        String    @map("tablet_id") @db.Uuid
  tablet          Tablet    @relation(fields: [tabletId], references: [id], onDelete: Cascade)
  grinderId       String    @map("grinder_id") @db.Uuid
  grinder         Grinder   @relation(fields: [grinderId], references: [id], onDelete: Cascade)
  /// Decaid's id for the record on that tablet.
  localId         String    @map("local_id")
  /// The record, as Decaid sent it.
  record          Json      @db.JsonB
  /// The record's updatedAt, placed in UTC by the plugin; null if it could not be.
  recordUpdatedAt DateTime? @map("record_updated_at") @db.Timestamptz(3)

  /// The latest edit of the item's content that the record has seen
  /// (`fieldEdits` `decidedAt`): when the edits it held were decided, by
  /// PostgreSQL's clock, as the server's write it answered carried them;
  /// null if none. Its own edits it has seen whatever this says (ADR-0020).
  contentSeenAt DateTime? @map("content_seen_at") @db.Timestamptz(3)

  @@id([tabletId, grinderId])
  @@unique([tabletId, localId])
  @@index([grinderId])
  @@map("tablet_grinders")
}

/// A Profile in the Library (ADR-0003): a program the machine follows while
/// pulling a shot, shown or hidden at each Location (ADR-0008). It keeps
/// Decaid's id, a hash of what the machine executes, which is the same on
/// every tablet, so its records carry no global id (ADR-0006). See
/// server/src/library/profiles.ts.
model Profile {
  /// Decaid's id, such as profile:3c5e9f0a1b2c4d6e8f70.
  id                String    @id
  /// Decaid's record fields, those it does not know included, as the tablet
  /// that created it sent them: all but its id, times and visibility, which
  /// belong to each tablet's record.
  content           Json      @db.JsonB
  /// One of Decaid's bundled Profiles, which every tablet has already and so
  /// is never written to one; whether it is shown is per Location all the same.
  bundled           Boolean   @default(false)
  /// Retired everywhere: shown nowhere, but kept so past Shots still name it.
  archived          Boolean   @default(false)
  /// The Location of the tablet that created it.
  createdLocationId String?   @map("created_location_id") @db.Uuid
  createdLocation   Location? @relation("ProfilesCreated", fields: [createdLocationId], references: [id], onDelete: SetNull)
  /// When it joined the Library, by PostgreSQL's clock.
  createdAt         DateTime  @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(3)
  /// The latest edit of its title, author and notes (ADR-0020), as
  /// `Bean.fieldEdits` keeps a Bean's fields. A bundled Profile's are never
  /// edited, as Decaid refuses to change them.
  fieldEdits        Json      @default("{}") @map("field_edits") @db.JsonB

  locations ProfileLocation[]
  tablets   TabletProfile[]
  versions  ItemVersion[]
  conflicts Conflict[]

  @@map("profiles")
}

/// Whether a Profile is shown at one Location (ADR-0008), a field of its own
/// (ADR-0020), with the time of the edit that set it: a tablet's by its
/// record's `updatedAt` in UTC (ADR-0003). A Location with no row for a
/// Profile hides it: a Profile is shown only where it was created until
/// someone shows it elsewhere.
model ProfileLocation {
  profileId         String   @map("profile_id")
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  locationId        String   @map("location_id") @db.Uuid
  location          Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  shown             Boolean
  /// The time of the edit that last showed or hid it there: a tablet's by its record's clock.
  changedAt         DateTime @map("changed_at") @db.Timestamptz(3)
  /// When that was decided, by PostgreSQL's clock: a tablet whose record has seen it had seen it (`TabletProfile.seenAt`).
  decidedAt         DateTime @default(dbgenerated("transaction_timestamp()")) @map("decided_at") @db.Timestamptz(3)
  /// The tablet whose edit decided that: a record it reports under the id
  /// afterwards, as after it deleted the Profile, was made after it. No
  /// foreign key: it is only compared with a reporting tablet's id, which a
  /// tablet gone since never is.
  decidedByTabletId String?  @map("decided_by_tablet_id") @db.Uuid
  /// The version that decided it (`ItemVersion`), as `BatchLocation.presenceVersionId`.
  versionId         String?  @map("version_id") @db.Uuid

  @@id([profileId, locationId])
  @@index([locationId])
  @@map("profile_locations")
}

/// A Library Profile's record on one tablet (ADR-0006), as `TabletBean`
/// keeps a Bean's: the record as that tablet last had it. Its id there is the
/// Profile's.
model TabletProfile {
  tabletId        String    @map("tablet_id") @db.Uuid
  tablet          Tablet    @relation(fields: [tabletId], references: [id], onDelete: Cascade)
  profileId       String    @map("profile_id")
  profile         Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// The record, as Decaid sent it.
  record          Json      @db.JsonB
  /// The record's updatedAt, placed in UTC by the plugin; null if it could not be.
  recordUpdatedAt DateTime? @map("record_updated_at") @db.Timestamptz(3)
  /// The latest decision of whether the Location shows the Profile that the
  /// record has seen (`ProfileLocation.decidedAt`): one the server's write to
  /// it carried, or one its own edit made; null if none (ADR-0020).
  seenAt          DateTime? @map("seen_at") @db.Timestamptz(3)
  /// The Location of that decision: it says nothing of another's. No foreign
  /// key: it is only compared with the tablet's Location now.
  seenLocationId  String?   @map("seen_location_id") @db.Uuid

  /// The latest edit of the item's content that the record has seen
  /// (`fieldEdits` `decidedAt`): when the edits it held were decided, by
  /// PostgreSQL's clock, as the server's write it answered carried them;
  /// null if none. Its own edits it has seen whatever this says (ADR-0020).
  contentSeenAt DateTime? @map("content_seen_at") @db.Timestamptz(3)

  @@id([tabletId, profileId])
  @@index([profileId])
  @@map("tablet_profiles")
}

/// One accepted edit of a Library item (ADR-0020): the fields it changed,
/// with their values, where it came from, and when. An edit of the item's
/// content has no Location; one of a Location's state of it (a batch at the
/// Location, its remaining weight there, a Profile shown there) names that
/// Location, and only those fields. Joining the Library is the item's first
/// version. Exactly one item column is set. See
/// server/src/library/history.ts.
model ItemVersion {
  id         String     @id @default(uuid(7)) @db.Uuid
  beanId     String?    @map("bean_id") @db.Uuid
  bean       Bean?      @relation(fields: [beanId], references: [id], onDelete: Cascade)
  batchId    String?    @map("batch_id") @db.Uuid
  batch      BeanBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  grinderId  String?    @map("grinder_id") @db.Uuid
  grinder    Grinder?   @relation(fields: [grinderId], references: [id], onDelete: Cascade)
  profileId  String?    @map("profile_id")
  profile    Profile?   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// A Location's steam, hot water and rinse settings, which it names as
  /// `locationId`.
  settingsId String?           @map("settings_id") @db.Uuid
  settings   LocationSettings? @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  locationId String?    @map("location_id") @db.Uuid
  location   Location?  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  /// The fields it set, by Decaid's names or a Location's state's
  /// (`atLocation`, `remainingWeight`, `shown`, or a shared setting such as
  /// `steamSettings.flow`), each with its value.
  fields     Json       @db.JsonB
  /// The Machine whose tablet made it, if one did.
  machineId  String?    @map("machine_id") @db.Uuid
  machine    Machine?   @relation(fields: [machineId], references: [id], onDelete: SetNull)
  tabletId   String?    @map("tablet_id") @db.Uuid
  tablet     Tablet?    @relation(fields: [tabletId], references: [id], onDelete: SetNull)
  /// The account that made it in the management interface, if one did.
  accountId  String?    @map("account_id") @db.Uuid
  account    Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  /// When it was made: a tablet's by its record's `updatedAt` in UTC, a
  /// delete, which Decaid does not time, by PostgreSQL's clock (ADR-0020).
  editedAt   DateTime   @map("edited_at") @db.Timestamptz(3)
  /// When the server took it in, by PostgreSQL's clock.
  receivedAt DateTime   @default(dbgenerated("transaction_timestamp()")) @map("received_at") @db.Timestamptz(3)
  /// The order it was taken in, which `receivedAt` cannot tell apart within one transaction.
  seq        BigInt     @default(autoincrement())

  @@index([beanId, receivedAt])
  @@index([batchId, receivedAt])
  @@index([grinderId, receivedAt])
  @@index([profileId, receivedAt])
  @@index([settingsId, receivedAt])
  @@index([locationId])
  @@index([machineId])
  @@index([tabletId])
  @@index([accountId])
  @@map("item_versions")
}

/// What became of a Conflict.
enum ConflictState {
  OPEN
  /// Someone used its value, which made it a new edit.
  USED
  DISMISSED

  @@map("conflict_state")
}

/// An edit to a field of a Library item that lost to another edit of the
/// same field made without seeing it (ADR-0020), kept until someone uses its
/// value or dismisses it: the item, the field, the losing value, where it
/// came from, and when it was made. Like `ItemVersion`, a field of a
/// Location's state names that Location. Exactly one item column is set.
model Conflict {
  id         String        @id @default(uuid(7)) @db.Uuid
  beanId     String?       @map("bean_id") @db.Uuid
  bean       Bean?         @relation(fields: [beanId], references: [id], onDelete: Cascade)
  batchId    String?       @map("batch_id") @db.Uuid
  batch      BeanBatch?    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  grinderId  String?       @map("grinder_id") @db.Uuid
  grinder    Grinder?      @relation(fields: [grinderId], references: [id], onDelete: Cascade)
  profileId  String?       @map("profile_id")
  profile    Profile?      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  settingsId String?           @map("settings_id") @db.Uuid
  settings   LocationSettings? @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  locationId String?       @map("location_id") @db.Uuid
  location   Location?     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  field      String
  /// The losing value; null where the edit cleared the field.
  value      Json?         @db.JsonB
  machineId  String?       @map("machine_id") @db.Uuid
  machine    Machine?      @relation(fields: [machineId], references: [id], onDelete: SetNull)
  tabletId   String?       @map("tablet_id") @db.Uuid
  tablet     Tablet?       @relation(fields: [tabletId], references: [id], onDelete: SetNull)
  accountId  String?       @map("account_id") @db.Uuid
  account    Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  /// When the losing edit was made, timed as `ItemVersion.editedAt` is.
  editedAt   DateTime      @map("edited_at") @db.Timestamptz(3)
  /// When it became a Conflict, by PostgreSQL's clock.
  createdAt  DateTime      @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(3)
  /// The order it became a Conflict, which `createdAt` cannot tell apart within one transaction.
  seq        BigInt        @default(autoincrement())
  state      ConflictState @default(OPEN)

  @@index([state, createdAt])
  @@index([beanId])
  @@index([batchId])
  @@index([grinderId])
  @@index([profileId])
  @@index([settingsId])
  @@index([locationId])
  @@index([machineId])
  @@index([tabletId])
  @@index([accountId])
  @@map("conflicts")
}

/// A Location's steam, hot water and rinse settings, shared by its Machines
/// whatever their model (ADR-0014), each a field of its own, merged as edits
/// of a Library item's content are (ADR-0020). The first Machine at the
/// Location to report its Workflow sets them; a setting no Machine with steam
/// on has reported yet is unset. See server/src/library/location-settings.ts.
model LocationSettings {
  id         String   @id @default(uuid(7)) @db.Uuid
  locationId String   @unique @map("location_id") @db.Uuid
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  /// Each setting set, by its name in SHARED_SETTINGS (protocol/), such as
  /// `steamSettings.flow`.
  values     Json     @default("{}") @db.JsonB
  /// Each setting's latest edit, as `Bean.fieldEdits` keeps a Bean's fields.
  fieldEdits Json     @default("{}") @map("field_edits") @db.JsonB
  /// When the first Machine there reported them, by PostgreSQL's clock.
  createdAt  DateTime @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(3)

  tablets   TabletSettings[]
  versions  ItemVersion[]
  conflicts Conflict[]

  @@map("location_settings")
}

/// A tablet's shared settings as it last had them, reported in its Workflow
/// or as Decaid returned the plugin's write of them, as `TabletBean` keeps a
/// Bean's record: what an edit there is compared with. They are of its
/// Machine's Location's settings then; a tablet whose Machine moved, or that
/// moved to a Machine at another Location, has had none of the new settings
/// yet.
model TabletSettings {
  tabletId      String           @id @map("tablet_id") @db.Uuid
  tablet        Tablet           @relation(fields: [tabletId], references: [id], onDelete: Cascade)
  settingsId    String           @map("settings_id") @db.Uuid
  settings      LocationSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  /// Each setting, by its name in SHARED_SETTINGS, as the tablet's Workflow held it.
  values        Json             @db.JsonB
  /// The latest edit of the settings that they have seen (`fieldEdits`
  /// `decidedAt`), by PostgreSQL's clock, as the server's write they
  /// answered carried them; null if none (ADR-0020).
  contentSeenAt DateTime?        @map("content_seen_at") @db.Timestamptz(3)

  @@index([settingsId])
  @@map("tablet_settings")
}

/// A Bean, Bean Batch or Grinder an Admin hard-deleted, by its global id,
/// kept so a record carrying that id that a tablet reports later, as one
/// that was offline, is deleted there too rather than taken in as new
/// (server/src/library/hard-deletes.ts).
model DeletedItem {
  /// `bean`, `beanBatch` or `grinder`.
  kind      String
  itemId    String   @map("item_id") @db.Uuid
  /// When it was deleted, by PostgreSQL's clock.
  deletedAt DateTime @default(dbgenerated("transaction_timestamp()")) @map("deleted_at") @db.Timestamptz(3)

  @@id([kind, itemId])
  @@map("deleted_items")
}

/// A record of a hard-deleted item that a tablet still holds, by its id
/// there, which that tablet's writer deletes. Gone once the plugin answers
/// the delete, or once a report no longer lists the record.
model TabletDeletion {
  tabletId String @map("tablet_id") @db.Uuid
  tablet   Tablet @relation(fields: [tabletId], references: [id], onDelete: Cascade)
  /// `bean`, `beanBatch` or `grinder`.
  kind     String
  /// Decaid's id for the record on that tablet.
  localId  String @map("local_id")
  /// The deleted item's global id, which the record carries.
  itemId   String @map("item_id") @db.Uuid
  /// For a batch's record, the global id of its Bean, whose record is
  /// deleted only once the batch's is, as Decaid deletes a bean's batches
  /// with it.
  beanId   String? @map("bean_id") @db.Uuid

  @@id([tabletId, kind, localId])
  @@map("tablet_deletions")
}
