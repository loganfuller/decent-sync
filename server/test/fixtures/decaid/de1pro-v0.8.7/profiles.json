          "flow": 8.0,
          "limiter": {
            "value": 0.0,
            "range": 0.6
          }
        },
        {
          "name": "dynamic bloom",
          "pump": "flow",
          "transition": "fast",
          "exit": {
            "type": "pressure",
            "condition": "under",
            "value": 2.2
          },
          "volume": 100.0,
          "seconds": 40.0,
          "weight": 0.0,
          "temperature": 70.0,
          "sensor": "coffee",
          "flow": 0.0,
          "limiter": {
