    "exchanges": [
      {
        "request": {
          "method": "PUT",
          "path": "/plugins/notice-probe.reaplugin/source",
          "body": {
            "manifest": {
              "id": "notice-probe.reaplugin",
              "author": "Decent Sync's fixtures",
              "name": "Notice probe",
              "description": "Puts up and withdraws the notices it is asked to, and answers with what host.notify returned and the notificationResult events that followed. For recording fixtures on a throwaway Decaid.",
              "version": "0.0.1",
              "apiVersion": 1,
              "permissions": [
                "log",
                "api",
                "notifications"
              ],
              "settings": {
                "Note": {
                  "type": "string",
                  "label": "Note",
                  "description": "Any text"
                }
              },
              "api": [
                {
                  "id": "call",
                  "type": "http",
                  "data": {}
                }
              ]
            },
            "plugin": "// A plugin that makes the `host.notify` and `host.dismissNotification` calls it is asked to, one after another, then\n// waits a moment and answers with what each call returned or threw and every event delivered to it since the request\n// began (README.md beside record.mjs). Installed on a throwaway Decaid only.\nfunction createPlugin(host) {\n  let events = [];\n  let loads = 0;\n  return {\n    id: \"notice-probe.reaplugin\",\n    version: \"0.0.1\",\n    onLoad(settings) {\n      loads += 1;\n      host.log(\"notice probe loaded with \" + JSON.stringify(settings || {}));\n    },\n    onUnload() {},\n    onEvent(event) {\n      events.push(event);\n    },\n    __httpRequestHandler: async (request) => {\n      const calls = (request.body && request.body.calls) || [];\n      const waitMs = (request.body && request.body.waitMs) || 1500;\n      events = [];\n      const answers = [];\n      for (const call of calls) {\n        try {\n          if (call.op === \"notify\") answers.push({ returned: host.notify(call.notice) });\n          else if (call.op === \"dismiss\") answers.push({ returned: call.id === undefined ? host.dismissNotification() : host.dismissNotification(call.id) });\n          else answers.push({ unknownOp: call.op });\n        } catch (error) {\n          answers.push({ threw: { name: error && error.name, message: String((error && error.message) || error) } });\n        }\n      }\n      await new Promise((resolve) => setTimeout(resolve, waitMs));\n      // `undefined` would be dropped from the JSON, so a call that returned nothing says so.\n      const returned = answers.map((answer) => (\"returned\" in answer && answer.returned === undefined ? { returnedNothing: true } : answer));\n      return {\n        status: 200,\n        headers: { \"content-type\": \"application/json\" },\n        body: JSON.stringify({ calls: returned, events: events.filter((event) => event && event.name !== \"stateUpdate\" && event.name !== \"workflowUpdated\"), loads }),\n      };\n    },\n  };\n}\n"
          }
        },
        "response": {
          "status": 200,
          "body": {
            "message": "Plugin source updated",
            "id": "notice-probe.reaplugin",
            "version": "0.0.1",
            "loaded": false
          }
        }
      },
      {
        "request": {
          "method": "POST",
          "path": "/plugins/notice-probe.reaplugin/enable"
        },
        "response": {
          "status": 200,
          "body": {
            "message": "Plugin enabled",
            "id": "notice-probe.reaplugin"
          }
        }
      }
    ],
    "center": {
      "key": null
    }
  },
